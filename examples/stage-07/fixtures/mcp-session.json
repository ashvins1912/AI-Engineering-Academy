{
  "scenario": "MCP host connects to a tools server and discovers one read-only order tool",
  "protocolVersion": "2026-07-28",
  "client": {
    "name": "academy-host",
    "version": "1.0.0"
  },
  "server": {
    "name": "academy-tools",
    "version": "1.0.0"
  },
  "lifecycle": [
    "optional server/discover",
    "tools/list with request-scoped _meta",
    "host consent and authorization",
    "tools/call with Mcp-Method and Mcp-Name headers",
    "validate resultType=complete"
  ],
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "tool": {
    "name": "lookup_order",
    "arguments": {
      "order_id": "ORD-7"
    },
    "requiredConsent": true,
    "cache": {
      "ttlMs": 30000,
      "cacheScope": "private"
    }
  },
  "trustBoundaries": [
    "host owns user consent",
    "client owns protocol session",
    "server validates tool schema",
    "domain gateway owns tenant authorization"
  ],
  "sessionModel": "stateless: no initialize/initialized handshake and no MCP-Session-Id"
}
