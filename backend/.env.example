ACADEMY_DATABASE_URL=postgresql+asyncpg://academy_app:academy-app-local-only@localhost:5432/academy
# Configure exactly one trusted key source. JWKS is preferred for rotation.
ACADEMY_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
# Fallback for providers without JWKS; use a PEM RS256 public key.
# ACADEMY_JWT_PUBLIC_KEY=
ACADEMY_JWT_ISSUER=https://your-identity-provider.example/
ACADEMY_JWT_AUDIENCE=ai-engineering-academy
ACADEMY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ACADEMY_EMBEDDING_DIMENSION=384
ACADEMY_EMBEDDING_DEVICE=cpu
ACADEMY_OCR_ENABLED=true
ACADEMY_OCR_LANGUAGE=eng
ACADEMY_OCR_DPI=160
ACADEMY_MAX_UPLOAD_BYTES=10485760
ACADEMY_MAX_REQUEST_BYTES=11534336
ACADEMY_MAX_PDF_PAGES=50
ACADEMY_MAX_OCR_PAGES=20
ACADEMY_MAX_EXTRACTED_CHARS=500000
ACADEMY_CORS_ORIGINS=http://localhost:5173
ACADEMY_RATE_LIMIT_PER_MINUTE=20

# Asynchronous private object storage
ACADEMY_STORAGE_BACKEND=local
ACADEMY_STORAGE_ROOT=./var/private-uploads
# Production S3-compatible configuration; use a private bucket and a KMS key.
# ACADEMY_STORAGE_BACKEND=s3
# ACADEMY_S3_BUCKET=
# ACADEMY_S3_KMS_KEY_ID=
# ACADEMY_S3_PREFIX=academy-private
# ACADEMY_S3_ENDPOINT_URL=
# Require malware scanning for public uploads; API fails closed if ClamAV is unavailable.
ACADEMY_MALWARE_SCAN_REQUIRED=false
# ACADEMY_CLAMAV_HOST=clamav
ACADEMY_CLAMAV_PORT=3310
ACADEMY_INGESTION_JOB_MAX_ATTEMPTS=5
ACADEMY_INGESTION_JOB_LEASE_SECONDS=900

# Optional remote embedding endpoint (OpenAI-compatible /embeddings response)
# Keeps embedding model weights out of the API/worker process; disabled by default.
ACADEMY_EMBEDDING_PROVIDER=local
# ACADEMY_EMBEDDING_API_URL=https://embedding-service.example/v1/embeddings
# ACADEMY_EMBEDDING_API_KEY=
ACADEMY_EMBEDDING_TIMEOUT_SECONDS=20

# Grounded answer generation is disabled until explicitly configured.
ACADEMY_GENERATION_ENABLED=false
# ACADEMY_GENERATION_API_URL=https://llm-provider.example/v1/chat/completions
# ACADEMY_GENERATION_API_KEY=
# ACADEMY_GENERATION_MODEL=
ACADEMY_GENERATION_TIMEOUT_SECONDS=30
ACADEMY_GENERATION_MAX_TOKENS=1000
ACADEMY_GENERATION_CONTEXT_CHARS=16000
